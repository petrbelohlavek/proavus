{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/petrbelohlavek/proavus/schema/relationship.schema.json",
  "title": "relationship – parent–child, partnership …",
  "type": "object",
  "allOf": [{ "$ref": "common.schema.json#/$defs/base" }],
  "required": ["type", "rel_type", "parties", "confidence"],
  "properties": {
    "type": { "const": "relationship" },
    "rel_type": { "type": "string", "x-vocab": "relationship_types" },
    "subtype": { "type": "string", "x-vocab": "relationship_subtypes" },
    "parties": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "person"],
        "additionalProperties": false,
        "properties": {
          "role": { "enum": ["parent", "child", "partner"] },
          "person": {
            "description": "Person ID, or \"unknown\" for an explicitly unknown parent (e.g. father unknown).",
            "x-hint": "a person ID or unknown",
      "anyOf": [{ "$ref": "common.schema.json#/$defs/ref_person" }, { "const": "unknown" }]
          }
        }
      }
    },
    "start": { "$ref": "common.schema.json#/$defs/edtf" },
    "end": { "$ref": "common.schema.json#/$defs/edtf" },
    "assertions": {
      "description": "Assertions supporting this relationship.",
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/ref_assertion" }
    },
    "citations": {
      "description": "Evidence for the relationship itself, without an assertion about it (ADR 0038).",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/citation" }
    },
    "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
    "confirmed": { "$ref": "common.schema.json#/$defs/confirmation" }
  },
  "unevaluatedProperties": false
}
