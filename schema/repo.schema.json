{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/petrbelohlavek/proavus/schema/repo.schema.json",
  "title": "repo.yaml – configuration of a family repository",
  "type": "object",
  "required": ["schema_version", "members"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string" },
    "regions": { "type": "array", "items": { "type": "string" } },
    "extensions": {
      "description": "Regional schema extensions switched on, e.g. [cz] → regions/cz/schema-ext.yaml",
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["abbr", "name"],
        "additionalProperties": false,
        "properties": {
          "abbr": { "$ref": "common.schema.json#/$defs/member" },
          "name": { "type": "string" },
          "role": { "enum": ["researcher", "helper", "maintainer"] }
        }
      }
    },
    "living_threshold_years": {
      "description": "Persons without a death date born less than this many years ago are treated as living (default 110).",
      "type": "integer",
      "minimum": 90,
      "maximum": 150
    },
    "map": {
      "description": "Settings of the generated family map views/mapa.html (tools/build_views.py, ADR 0027).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "description": "Starting person: the tree shows the ancestors of this person.",
          "$ref": "common.schema.json#/$defs/ref_person"
        },
        "lang": {
          "description": "Language of the map labels (default en).",
          "enum": ["en", "cs"]
        }
      }
    }
  },
  "additionalProperties": false
}
