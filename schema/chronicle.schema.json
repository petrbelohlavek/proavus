{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/petrbelohlavek/proavus/schema/chronicle.schema.json",
  "title": "chronicle – one research milestone (minimal in v0; what happened and why it matters in the body)",
  "type": "object",
  "allOf": [{ "$ref": "common.schema.json#/$defs/base" }],
  "required": ["type", "date", "milestone", "title", "confirmed"],
  "properties": {
    "type": { "const": "chronicle" },
    "date": { "$ref": "common.schema.json#/$defs/date" },
    "milestone": { "type": "string", "x-vocab": "milestone_types" },
    "title": { "type": "string", "minLength": 1 },
    "confirmed": { "$ref": "common.schema.json#/$defs/confirmation" }
  },
  "unevaluatedProperties": false
}
